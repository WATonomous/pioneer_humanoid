# ============================================================
#  Ultron Environment Variables
#  Copy this file to .env and fill in your values.
#  Ultron reads .env itself every time it runs (CLI and jobs),
#  so nothing here needs to be exported in your shell.
# ============================================================

# ── Claude Code (main brain) ─────────────────────────────────────────────────
# Nothing is required here: Ultron uses the login of the `claude` CLI
# (run `claude` once and use /login). No API key is used or billed.
# Optional: a long-lived token from `claude setup-token`, for jobs that must
# keep working even if the interactive login expires:
# CLAUDE_CODE_OAUTH_TOKEN=...
# Optional: path to the claude binary if it is not at ~/.local/bin/claude
# ULTRON_CLAUDE_BIN=/path/to/claude

# ── Discord Webhook ──────────────────────────────────────────────────────────
# Create a webhook in your Discord server:
#   Server Settings → Integrations → Webhooks → New Webhook
# Then paste the full URL here:
ULTRON_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# ── Ollama (local backup model, optional overrides) ──────────────────────────
# OLLAMA_HOST=http://localhost:11434
# ULTRON_OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_MODELS=/mnt/wato-drive2/rijul_chaddha/ollama_models
DOCKER_DATA_ROOT=/tmp/docker

# ── Hugging Face ─────────────────────────────────────────────────────────────
# Required for pushing checkpoints and datasets to HuggingFace
# HF_TOKEN=hf_...
