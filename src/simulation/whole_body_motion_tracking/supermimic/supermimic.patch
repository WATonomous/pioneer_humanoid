index 8005ba4..b67c72d 100644
--- a/src/supermimic/envs/mdp/terminations.py
+++ b/src/supermimic/envs/mdp/terminations.py
@@ -29,3 +29,25 @@ def bad_root_tilt(env: ManagerBasedRlEnv, command_name: str, threshold: float =
 def clip_end(env: ManagerBasedRlEnv, command_name: str) -> torch.Tensor:
     cmd = cast(MultiClipMotionCommand, env.command_manager.get_term(command_name))
     return cmd.clip_end
+
+
+def bad_root_xy(env: ManagerBasedRlEnv, command_name: str, threshold: float = 0.8) -> torch.Tensor:
+    """Root (pelvis) more than `threshold` m from the reference in the ground plane (Pioneer, not in the paper): with only
+    height/tilt terminations a policy that stands still while the clip walks away is never reset, and the global
+    position reward (std 0.3) gives it no gradient once it is ~1 m behind."""
+    cmd = cast(MultiClipMotionCommand, env.command_manager.get_term(command_name))
+    return (cmd.root_pos_w[:, :2] - cmd.robot_root_pos_w[:, :2]).norm(dim=-1) > threshold
+
+
+def sim_blowup(env: ManagerBasedRlEnv, command_name: str, max_vel: float = 100.0) -> torch.Tensor:
+    """Robot state non-finite or moving absurdly fast (a MuJoCo Warp blow-up; Pioneer's CAD-box hitboxes occasionally
+    do this on the ground clips). Reset it at once: one such row in the replay buffer turned the world model to NaN."""
+    cmd = cast(MultiClipMotionCommand, env.command_manager.get_term(command_name))
+    d = cmd.robot.data
+    parts = (d.joint_pos, d.joint_vel, d.root_link_pos_w, d.root_link_lin_vel_w, d.root_link_ang_vel_w)
+    bad = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
+    for x in parts:
+        bad |= ~torch.isfinite(x).all(dim=-1)
+    for x in parts[1:2] + parts[3:]:
+        bad |= (x.abs() > max_vel).any(dim=-1)
+    return bad
