+"""WATonomous Pioneer whole-body humanoid for SuperMimic on mjlab.
+
+Model: the MJCF from make_train_mjcf.py in the humanoid repo (floating pelvis, +X forward, fingers locked in fists,
+29 DoF: waist yaw, 2 neck, 7 per arm, 6 per leg). Actuators are DC motors with each joint's real torque and no-load
+speed (URDF limits): the hip pitch and knee AKH70-48 reach only 3.67 rad/s, which caps what motion can be tracked.
+PD gains follow the Isaac Lab locomotion config of the same robot (legs) and its arm-swing config (arms).
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+import mujoco
+from mjlab.actuator import DcMotorActuatorCfg
+from mjlab.entity import EntityArticulationInfoCfg, EntityCfg
+from mjlab.utils.spec_config import CollisionCfg
+
+PIONEER_XML = Path(os.environ["PIONEER_XML"])  # the training MJCF written by make_train_mjcf.py
+
+# MJCF joint order (= the retarget CSV's column order)
+JOINT_NAMES: tuple[str, ...] = (
+    "waist_yaw", "neck_yaw", "neck_pitch",
+    "r_shoulder_pitch", "r_shoulder_roll", "r_upper_arm_yaw", "r_elbow", "r_forearm_roll", "r_wrist_dev", "r_wrist_flex",
+    "l_shoulder_pitch", "l_shoulder_roll", "l_upper_arm_yaw", "l_elbow", "l_forearm_roll", "l_wrist_dev", "l_wrist_flex",
+    "Hip_F_L", "Hip_A_L", "Hip_R_L", "Knee_L", "Ankle_P_L", "Ankle_R_L",
+    "Hip_F_R", "Hip_A_R", "Hip_R_R", "Knee_R", "Ankle_P_R", "Ankle_R_R",
+)
+
+TRACKED_BODIES = (
+    "pelvis",
+    "l_hip_roll_link", "l_shank_foot", "l_foot",
+    "r_hip_roll_link", "r_shank_foot", "r_foot",
+    "torso",
+    "l_arm_link2", "l_arm_link4", "l_hand_H",
+    "r_arm_link2", "r_arm_link4", "r_hand_H",
+)
+ANCHOR_BODY = "torso"
+ROOT_BODY = "pelvis"
+FOOT_GEOM_REGEX = r"^(l|r)_foot_collision$"
+PELVIS_HEIGHT = 0.848
+
+
+def get_spec() -> mujoco.MjSpec:
+    return mujoco.MjSpec.from_file(str(PIONEER_XML))
+
+
+def _motor(names, effort, velocity, kp, kd):
+    return DcMotorActuatorCfg(
+        target_names_expr=names,
+        stiffness=kp,
+        damping=kd,
+        effort_limit=effort,
+        saturation_effort=effort,
+        velocity_limit=velocity,
+        armature=0.01,
+    )
+
+
+UPPER_VEL = 20.0 if os.environ.get("PIONEER_FAST") else 6.0  # waist / arm / wrist limits (URDF 6 rad/s)
+
+ACTUATORS = (
+    # AKH70-48: 3.67 rad/s no-load. PIONEER_FAST=1 lifts it to the other leg motors' ~21 rad/s (sim experiment only)
+    _motor((r"Hip_F_.", r"Knee_."), 222.0, 20.944 if os.environ.get("PIONEER_FAST") else 3.6652, 200.0, 5.0),
+    _motor((r"Hip_A_.",), 120.0, 20.944, 150.0, 5.0),
+    _motor((r"Hip_R_.",), 60.0, 20.42, 150.0, 5.0),
+    _motor((r"Ankle_._.",), 60.0, 20.42, 40.0, 2.0),
+    _motor(("waist_yaw",), 60.0, UPPER_VEL, 150.0, 5.0),
+    _motor((r"._shoulder_pitch", r"._shoulder_roll"), 53.0, UPPER_VEL, 40.0, 2.0),
+    _motor((r"._upper_arm_yaw", r"._elbow", r"._forearm_roll"), 22.0, UPPER_VEL, 20.0, 1.0),
+    _motor((r"._wrist_dev", r"._wrist_flex"), 2.0, UPPER_VEL, 4.0, 0.2),
+    # neck: held straight ahead. No reward tracks the head, so a policy-driven neck wandered up to ~55 deg; its two
+    # action entries stay (checkpoints still load) but are scaled to zero below
+    _motor(("neck_yaw", "neck_pitch"), 5.0, 6.0, 50.0, 2.0),
+)
+
+# feet: friction and condim 3. Self-collision only forearms/hands vs torso/neck/head/pelvis (the other CAD hitboxes
+# overlap at rest); without it the get-up policy pushed off by sweeping an arm through its own torso.
+ARM_GEOMS = r"^(l|r)_(forearm|hand_.*)_collision.*$"
+TRUNK_GEOMS = r"^(torso|neck_link|head|base_link)_collision.*$"
+SELF_COLLISION = bool(os.environ.get("PIONEER_SELFCOL"))  # off for checkpoints trained before it existed
+COLLISION = CollisionCfg(
+    geom_names_expr=(".*_collision.*",),
+    contype={ARM_GEOMS: 2, ".*": 0} if SELF_COLLISION else 0,
+    conaffinity={TRUNK_GEOMS: 3, ".*": 1} if SELF_COLLISION else 1,
+    condim={FOOT_GEOM_REGEX: 3, ".*_collision.*": 1},
+    priority={FOOT_GEOM_REGEX: 1, ".*": 0},
+    friction={FOOT_GEOM_REGEX: (0.8,)},
+)
+
+INIT_STATE = EntityCfg.InitialStateCfg(
+    pos=(0, 0, PELVIS_HEIGHT),
+    joint_pos={r"Hip_F_.": 0.25, r"Knee_.": -0.5, r"Ankle_P_.": -0.25, ".*": 0.0},
+    joint_vel={".*": 0.0},
+)
+
+ARTICULATION = EntityArticulationInfoCfg(actuators=ACTUATORS, soft_joint_pos_limit_factor=0.9)
+
+
+def get_pioneer_robot_cfg() -> EntityCfg:
+    return EntityCfg(init_state=INIT_STATE, collisions=(COLLISION,), spec_fn=get_spec, articulation=ARTICULATION)
+
+
+PIONEER_ACTION_SCALE: dict[str, float] = {}
+for a in ACTUATORS:
+    for n in a.target_names_expr:
+        PIONEER_ACTION_SCALE[n] = 0.0 if n.startswith("neck") else 0.25 * a.effort_limit / a.stiffness
