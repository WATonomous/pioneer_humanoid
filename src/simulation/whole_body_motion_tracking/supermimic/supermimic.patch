+    def _mismatch_lying_start(self, r, root_pos, root_ori, root_lin_vel, root_ang_vel, joint_pos, joint_vel) -> None:
+        """Pioneer get-up robustness (env PIONEER_MISMATCH_P): an episode that starts on a lying reference frame starts the
+        robot, with that probability, in a different lying pose from the library (turned to the reference's heading, at
+        rest), so the policy learns to get up from wherever it fell rather than only from the reference's own start."""
+        p = float(os.environ.get("PIONEER_MISMATCH_P", "0"))
+        if p <= 0:
+            return
+        if not hasattr(self, "_lying_frames"):
+            z = torch.cat([self.library.ref(torch.arange(i, min(i + 65536, self.library.num_frames), device=self.device)).root_pos_w[:, 2]
+                           for i in range(0, self.library.num_frames, 65536)])
+            self._lying_frames = (z < 0.4).nonzero().squeeze(-1)
+        swap = ((r.root_pos_w[:, 2] < 0.4) & (torch.rand(len(root_pos), device=self.device) < p)).nonzero().squeeze(-1)
+        if swap.numel() == 0 or self._lying_frames.numel() == 0:
+            return
+        o = self.library.ref(self._lying_frames[torch.randint(0, self._lying_frames.numel(), (swap.numel(),), device=self.device)])
+        turn = quat_mul(yaw_quat(r.root_quat_w[swap]), quat_inv(yaw_quat(o.root_quat_w)))
+        root_ori[swap] = quat_mul(turn, o.root_quat_w)
+        root_pos[swap, 2] = o.root_pos_w[:, 2]
+        joint_pos[swap] = o.joint_pos
+        root_lin_vel[swap] = 0.0
+        root_ang_vel[swap] = 0.0
+        joint_vel[swap] = 0.0
+
     def update_relative_body_poses(self) -> None:
         nb = len(self.cfg.body_names)
         anchor_pos = self.anchor_pos_w[:, None, :].repeat(1, nb, 1)
