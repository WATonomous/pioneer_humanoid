<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wrist_camera</name>
  <version>0.0.0</version>
  <description>Real wrist camera, rectified to the pinhole the sim wrist cameras render</description>
  <maintainer email="watonomous@uwaterloo.ca">watonomous</maintainer>
  <license>Apache-2.0</license>

  <!-- Also needs, via pip: src/pioneer_humanoid and src/perception/camera_calibration (see README). -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
